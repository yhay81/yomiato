{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yomiato",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "yomiato.yhay81.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yomiato",
      "database_id": "b4f956cb-d9e7-4fc0-918b-7571345385f3",
    },
  ],
  "triggers": {
    "crons": ["53 18 * * *"],
  },
}
